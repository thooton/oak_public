{
  "manifest_version": 3,
  "name": "Oak",
  "version": "1.0.0",
  "description": "Lets Oak's agent use the tabs you allow it in Oak, through the browser's debugger.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
